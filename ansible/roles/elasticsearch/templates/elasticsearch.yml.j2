# ======================== Elasticsearch Configuration =========================
cluster.name: single-node-cluster
node.name: node-1

# Path to directory where to store data
path.data: /var/lib/elasticsearch

# Path to log files
path.logs: /var/log/elasticsearch

# Network configuration
network.host: {{ elasticsearch_host }}
http.port: {{ elasticsearch_port }}

# Single-Node configuration
discovery.type: single-node

# ======================== X-Pack Security =====================================
xpack.security.enabled: true

# Disable TLS/SSL for HTTP (recommended for dev/internal network to avoid cert errors)
xpack.security.http.ssl.enabled: false

# Disable transport TLS/SSL (allowed for single-node cluster discovery)
xpack.security.transport.ssl.enabled: false
