# Copy to terraform.tfvars and fill in your own values.
# In the Jenkins pipeline these are instead passed as -var flags backed by
# Jenkins credentials/parameters — see ../Jenkinsfile.

aws_region   = "ap-south-1"
project_name = "elk"

key_name   = "my-ec2-keypair"      # must already exist in the target AWS account/region
admin_cidr = "203.0.113.10/32"     # YOUR IP only — never leave this as 0.0.0.0/0

bastion_instance_type = "t3.micro"
app_instance_type     = "t3.medium"

asg_min_size         = 2
asg_max_size         = 4
asg_desired_capacity = 2
